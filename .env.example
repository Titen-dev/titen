# Titen settings for local development.
# For normal CLI use, run `titen setup` instead (saves to ~/.titen/config.json).

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any OpenRouter model that supports tools (default anthropic/claude-haiku-5.5)
# TITEN_MODEL=anthropic/claude-sonnet-5.5

# Optional: web search engine for the OpenRouter web plugin (default exa)
# TITEN_SEARCH_ENGINE=exa
