{
  "name": "@titen-dev/titen",
  "version": "0.1.0",
  "description": "An AI agent that reads the signs of the world: trend radar, daily briefs, TL;DR for any link, scam checks and page/topic watching.",
  "license": "MIT",
  "author": "Titen-dev",
  "homepage": "https://github.com/Titen-dev/titen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Titen-dev/titen.git"
  },
  "bugs": {
    "url": "https://github.com/Titen-dev/titen/issues"
  },
  "type": "module",
  "bin": {
    "titen": "cli/index.js"
  },
  "files": [
    "cli/",
    "core/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node web/server.js",
    "web": "node web/server.js --open",
    "titen": "node cli/index.js",
    "cf:build": "node scripts/build-worker.mjs",
    "cf:dev": "node scripts/build-worker.mjs && npx --yes wrangler@4 dev",
    "cf:deploy": "node scripts/build-worker.mjs && npx --yes wrangler@4 deploy"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "trends",
    "news",
    "brief",
    "summary",
    "tldr",
    "scam",
    "phishing",
    "monitor",
    "watch",
    "openrouter"
  ],
  "publishConfig": {
    "access": "public"
  }
}
